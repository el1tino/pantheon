# Copy to .env and fill in. .env is git-ignored; keys never reach the browser.

# Get a key at https://openrouter.ai/keys and set a spending limit there too.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cheap model for development runs. Check current IDs at https://openrouter.ai/models
DEFAULT_MODEL=openai/gpt-4o-mini
TEST_CALL_MAX_TOKENS=400

# Optional. Default: pantheon.db and projects/ at the repo root.
# DATABASE_URL=sqlite:////absolute/path/to/pantheon.db
# PROJECTS_DIR=/absolute/path/to/projects

FRONTEND_ORIGIN=http://localhost:3000
