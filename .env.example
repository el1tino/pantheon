# Copy to .env and fill in. .env is git-ignored; keys never reach the browser.

# Get a key at https://openrouter.ai/keys and set a spending limit there too.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cheap model for development runs. Check current IDs at https://openrouter.ai/models
DEFAULT_MODEL=openai/gpt-4o-mini
TEST_CALL_MAX_TOKENS=400

# Debate engine
MODERATOR_MODEL=openai/gpt-4o-mini
MAX_ROUNDS=3
DEFAULT_BUDGET_USD=0.25
REPLY_MAX_TOKENS=500
MAKE_MAX_TOKENS=1400       # a seat writing its part of the work
VERDICT_MAX_TOKENS=2000    # the moderator assembling the result
BUILD_MAX_TOKENS=4000      # a seat writing files in the build phase
CALL_TIMEOUT_S=90
# Used for cost estimates only if OpenRouter's price list can't be fetched (USD per 1M tokens).
FALLBACK_PRICE_IN_PER_MTOK=5
FALLBACK_PRICE_OUT_PER_MTOK=20

# Optional. Default: pantheon.db and projects/ at the repo root.
# DATABASE_URL=sqlite:////absolute/path/to/pantheon.db
# PROJECTS_DIR=/absolute/path/to/projects

# The only browser origin allowed to send writes and open the live event WebSocket.
FRONTEND_ORIGIN=http://localhost:3000

# Login. The owner account is created on first start from these (password: 10+ characters).
# Everyone else joins through a one-use invite link the owner makes. After the first start the
# password can be removed from here; only its Argon2 hash is stored.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false        # true when served over HTTPS (docker-compose.yml sets it)
SESSION_DAYS=30
INVITE_DAYS=7

# Demo mode: no new runs; visitors can only replay the recorded runs in demo/, without logging in.
DEMO_MODE=false

# Deployment with docker-compose.yml (see docs/DEPLOY.md). Not used by the dev setup.
DOMAIN=
DOCKER_GID=999             # getent group docker | cut -d: -f3

# Frontend (read by Next.js from frontend/.env.local, not this file). Not secret. By default the
# WebSocket goes to the page's own host, or to :8000 when the page is on :3000 (development).
# NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000

# Image consultants (optional). A provider without a key is unavailable; with none, a free
# practice consultant draws simple SVGs locally. Keys go only to their own provider.
RECRAFT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
BFL_API_KEY=
SEEDREAM_API_KEY=

# Integrate phase: build the runner once with  docker build -t pantheon-runner:1 backend/runner
RUNNER_IMAGE=pantheon-runner:1
RUNNER_TIMEOUT_S=30
RUNNER_MEMORY=256m
RUNNER_CPUS=1
